# Server-only OpenAI credentials (leave blank locally until configured)
OPENAI_API_KEY=
OPENAI_PROJECT_ID=

# Model routing (not secrets)
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Supabase (server secret must never be exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional server-only providers
DATA_GO_KR_SERVICE_KEY=
KAKAO_REST_API_KEY=
